# Database configuration
# Local development defaults to sqlite, production targets PostgreSQL
DATABASE_URL=sqlite:///./kanha.db

# Security & Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-256-bit-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google GenAI / Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# SMTP/Email config (Optional, mocks if not configured)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=password
EMAILS_FROM_EMAIL=no-reply@kanha.local
EMAILS_FROM_NAME=KANHA Platform

# CORS Configuration
# Local dev defaults to localhost list, production must lock down to your specific frontend client domain(s)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "https://kanha.yourdomain.com"]

